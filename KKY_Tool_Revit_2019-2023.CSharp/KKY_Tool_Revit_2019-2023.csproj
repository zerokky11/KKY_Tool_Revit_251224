<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <RootNamespace>KKY_Tool_Revit</RootNamespace>
    <AssemblyName>KKY_Tool_Revit</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <PropertyGroup>
    <RevitYear Condition="'$(RevitYear)'==''">2023</RevitYear>
    <RevitInstallDir Condition="'$(RevitInstallDir)'==''">C:\Program Files\Autodesk\Revit $(RevitYear)</RevitInstallDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2592.51" />
    <PackageReference Include="NPOI" Version="2.6.1" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="RevitAPI">
      <HintPath>$(RevitInstallDir)\RevitAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>$(RevitInstallDir)\RevitAPIUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="APP.cs" />
    <Compile Include="Commands\CmdOpenHub.cs" />
    <Compile Include="Exports\DuplicateExport.cs" />
    <Compile Include="Exports\ConnectorExport.cs" />
    <Compile Include="Exports\PointsExport.cs" />
    <Compile Include="Infrastructure\ElementIdCompat.cs" />
    <Compile Include="Infrastructure\ExcelCore.cs" />
    <Compile Include="Infrastructure\ResourceExtractor.cs" />
    <Compile Include="Infrastructure\SharedParamReader.cs" />
    <Compile Include="Services\DuplicateAnalysisService.cs" />
    <Compile Include="Services\ConnectorDiagnosticsService.cs" />
    <Compile Include="Services\ExportPointsService.cs" />
    <Compile Include="Services\GuidAuditService.cs" />
    <Compile Include="Services\SegmentPmsCheckService.cs" />
    <Compile Include="Services\ParamPropagateService.cs" />
    <Compile Include="UI\Hub\HubHostWindow.cs" />
    <Compile Include="UI\Hub\UiBridgeExternalEvent.Core.cs" />
    <Compile Include="UI\Hub\UiBridgeExternalEvent.Connector.cs" />
    <Compile Include="UI\Hub\UiBridgeExternalEvent.Duplicate.cs" />
    <Compile Include="UI\Hub\UiBridgeExternalEvent.Export.cs" />
    <Compile Include="UI\Hub\UiBridgeExternalEvent.ParamProp.cs" />
    <Compile Include="UI\Hub\UiBridgeExternalEvent.SegmentPms.cs" />
    <Compile Include="UI\Hub\UiBridgeExternalEvent.Guid.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\KKY_Tool_Revit_2019-2023\Resources\HubUI\**\*">
      <Link>Resources\HubUI\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
